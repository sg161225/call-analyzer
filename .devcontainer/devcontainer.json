{
  "name": "Call Analyzer",
  "image": "ghcr.io/sg161225/call-analyzer-devcontainer:latest",
  "postCreateCommand": "bash .devcontainer/ensure-deps.sh",
  "postAttachCommand": "bash .devcontainer/start-app.sh",
  "forwardPorts": [
    8501
  ],
  "portsAttributes": {
    "8501": {
      "label": "Call Analyzer",
      "onAutoForward": "openBrowser"
    }
  },
  "secrets": {
    "GROQ_API_KEY": {
      "description": "Optional: free Groq key (console.groq.com). You can also paste it on the app's Settings page."
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "settings": {
        "python.createEnvironment.trigger": "off",
        "python-envs.workspaceSearchPaths": []
      }
    }
  }
}
